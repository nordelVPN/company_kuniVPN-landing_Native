<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" data-i18n-content="{{descriptionKey}}" content="{{t descriptionKey}}"><meta name="theme-color" content="#080808"><title data-i18n="{{titleKey}}">{{t titleKey}}</title>{{#if pageFlags.account}}<style>[data-auth-gate][hidden]{display:none!important;}</style><script>(function(){try{if(window.__VPN_PORTAL_CONFIG__&&window.__VPN_PORTAL_CONFIG__.mode==='demo')return;if(!window.localStorage.getItem('kuni-vpn-portal:token')){window.location.replace('./login.html');}}catch(e){window.location.replace('./login.html');}})();</script>{{/if}}</head><body><a class="skip" href="#main" data-i18n="К содержимому">{{t "К содержимому"}}</a>{{> header}}<main id="main"{{#if pageFlags.account}} hidden data-auth-gate{{/if}}>{{{body}}}</main>{{> footer}}</body></html>