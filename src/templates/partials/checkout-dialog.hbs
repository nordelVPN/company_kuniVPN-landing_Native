<dialog id="checkout" aria-labelledby="checkout-title"><div class="dialog-shell"><button type="button" class="secondary dialog-close" data-close-dialog aria-label="{{t 'Close'}}" data-i18n-aria-label="Close">×</button><div class="checkout-art"><h2><span data-i18n="Checkout">{{t "Checkout"}}</span></h2><p class="lead"><span data-i18n="Review your plan in a few simple steps.">{{t "Review your plan in a few simple steps."}}</span></p><div class="checkout-shield"><img src="{{asset 'logo-shield.png'}}" width="460" height="320" alt=""><span class="checker"></span></div></div><div class="checkout-content"><h2 id="checkout-title"><span data-i18n="Order summary">{{t "Order summary"}}</span></h2><p class="prototype-note"><span data-i18n="Prototype. No service is connected. Use sample data only.">{{t "Prototype. No service is connected. Use sample data only."}}</span></p><label for="checkout-plan"><span data-i18n="Plan">{{t "Plan"}}</span></label><select id="checkout-plan" data-plan>{{#each plans}}<option value="{{id}}" data-i18n="{{name}}">{{t name}}</option>{{/each}}</select>{{#each plans}}<section class="order-summary" data-plan-summary="{{id}}"><div class="summary-badge">{{> icon shield=true}}<span data-i18n="Selected plan">{{t "Selected plan"}}</span></div><h3 data-i18n="{{name}}">{{t name}}</h3>{{> plan-details}}<ul class="plan-facts"><li><span data-i18n="Plan details">{{t "Plan details"}}</span></li><li><span data-i18n="One offer for 5 devices.">{{t "One offer for 5 devices."}}</span></li><li><span data-i18n="Payment integration pending.">{{t "Payment integration pending."}}</span></li></ul></section>{{/each}}<form data-form="checkout" novalidate><div class="field"><label for="checkout-email"><span data-i18n="Email address">{{t "Email address"}}</span></label><div class="input-wrap">{{> icon mail=true}}<input id="checkout-email" name="checkout-email" type="email" required autocomplete="email" aria-describedby="checkout-email-error"></div><p id="checkout-email-error" class="field-error" aria-live="polite"></p></div><label for="payment-method"><span data-i18n="Payment method">{{t "Payment method"}}</span></label><select id="payment-method" name="payment-method"><option value="card" data-i18n="Card via provider">{{t "Card via provider"}}</option><option value="wallet" data-i18n="Wallet via provider">{{t "Wallet via provider"}}</option></select><p><span data-i18n="Currency and payment provider are not specified. Card details are not collected.">{{t "Currency and payment provider are not specified. Card details are not collected."}}</span></p><button class="button wide" type="submit"><span data-i18n="Continue to payment">{{t "Continue to payment"}}</span><span aria-hidden="true">→</span></button><p class="form-message" data-form-message role="status" aria-live="polite"></p></form><div class="checkout-trust"><div>{{> icon lock=true}}<span data-i18n="Encrypted and protected">{{t "Encrypted and protected"}}</span></div><div>{{> icon }}<span data-i18n="Quick & Easy">{{t "Quick & Easy"}}</span></div><div>{{> icon device=true}}<span data-i18n="Use on All Devices">{{t "Use on All Devices"}}</span></div></div><p class="prototype-note"><span data-i18n="Payment integration pending.">{{t "Payment integration pending."}}</span></p></div></div></dialog>