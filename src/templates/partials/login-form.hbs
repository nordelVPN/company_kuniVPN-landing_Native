<form data-form="login" novalidate><div class="field"><label class="sr-only" for="email"><span data-i18n="Email address">{{t "Email address"}}</span></label><div class="input-wrap">{{> icon mail=true}}<input id="email" placeholder="{{t 'Email address'}}" data-i18n-placeholder="Email address" name="email" type="email" required autocomplete="email" aria-describedby="email-error"></div><p id="email-error" class="field-error" aria-live="polite"></p></div><div class="field"><label class="sr-only" for="password"><span data-i18n="Password">{{t "Password"}}</span></label><div class="password">{{> icon lock=true}}<input id="password" placeholder="{{t 'Password'}}" data-i18n-placeholder="Password" name="password" type="password" required autocomplete="current-password" minlength="8" aria-describedby="password-error"><button type="button" class="secondary" data-password="password" aria-controls="password" aria-pressed="false" aria-label="{{t 'Показать'}}" data-i18n-aria-label="Показать">{{> icon eye=true}}<span class="sr-only" data-password-label data-i18n="Показать">{{t "Показать"}}</span></button></div><p id="password-error" class="field-error" aria-live="polite"></p></div><div class="form-options"><label class="check"><input type="checkbox" name="remember"><span data-i18n="Keep me signed in">{{t "Keep me signed in"}}</span></label><a href="./forgot-password.html"><span data-i18n="Forgot password?">{{t "Forgot password?"}}</span></a></div><button class="button wide" type="submit"><span data-i18n="Sign in">{{t "Sign in"}}</span></button><p class="form-message" data-form-message role="status" aria-live="polite"></p><p class="signup-line"><span data-i18n="Don't have an account?">{{t "New here?"}}</span> <a href="./create-account.html"><span data-i18n="Create account">{{t "Create account"}}</span></a></p></form><p class="prototype-note"><span data-i18n="Prototype. No service is connected. Use sample data only.">{{t "Prototype. No service is connected. Use sample data only."}}</span></p>