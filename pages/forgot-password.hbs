<section class="hero wrap auth-page">{{> auth-art}}<div class="form-card"><p class="eyebrow">kuniVPN</p><h1><span data-i18n="Forgot password">{{t "Forgot password"}}</span></h1><p class="notice"><span data-i18n="Prototype. No service is connected. Use sample data only.">{{t "Prototype. No service is connected. Use sample data only."}}</span></p><div data-recovery><form data-form="recovery" novalidate><div class="field"><label for="recovery-email"><span data-i18n="Email address">{{t "Email address"}}</span></label><div class="input-wrap"><input id="recovery-email" name="recovery-email" type="email" required autocomplete="email" aria-describedby="recovery-email-error"></div><p id="recovery-email-error" class="field-error" aria-live="polite"></p></div><button class="button wide" type="submit"><span data-i18n="Send instructions">{{t "Send instructions"}}</span></button><p class="form-message" data-form-message role="status" aria-live="polite"></p></form></div><div data-reset hidden><p class="notice" data-token-state></p><form data-form="reset" novalidate><div class="field"><label for="reset-password"><span data-i18n="New password">{{t "New password"}}</span></label><div class="password"><input id="reset-password" name="reset-password" type="password" required autocomplete="new-password" minlength="8" aria-describedby="reset-password-error"><button type="button" class="secondary" data-password="reset-password" aria-controls="reset-password" aria-pressed="false" data-i18n="Показать">{{t "Показать"}}</button></div><p id="reset-password-error" class="field-error" aria-live="polite"></p></div><div class="field"><label for="reset-confirm"><span data-i18n="Confirm password">{{t "Confirm password"}}</span></label><div class="password"><input id="reset-confirm" name="reset-confirm" type="password" required autocomplete="new-password" data-confirm="reset-password" aria-describedby="reset-confirm-error"><button type="button" class="secondary" data-password="reset-confirm" aria-controls="reset-confirm" aria-pressed="false" data-i18n="Показать">{{t "Показать"}}</button></div><p id="reset-confirm-error" class="field-error" aria-live="polite"></p></div><button class="button wide" type="submit"><span data-i18n="Reset password">{{t "Reset password"}}</span></button><p class="form-message" data-form-message role="status" aria-live="polite"></p></form></div><a href="./login.html"><span data-i18n="Back to sign in">{{t "Back to sign in"}}</span></a><details class="demo-states"><summary><span data-i18n="Preview recovery states">{{t "Preview recovery states"}}</span></summary><p><span data-i18n="Demo only. No email is sent and no password is changed.">{{t "Demo only. No email is sent and no password is changed."}}</span></p><button class="secondary" data-preview-recovery="confirmation"><span data-i18n="Confirmation">{{t "Confirmation"}}</span></button><button class="secondary" data-preview-recovery="retry"><span data-i18n="Retry">{{t "Retry"}}</span></button><a href="./forgot-password.html?token=demo"><span data-i18n="Demo reset">{{t "Demo reset"}}</span></a> · <a href="./forgot-password.html?token=expired"><span data-i18n="Expired token">{{t "Expired token"}}</span></a> · <a href="./forgot-password.html?token=invalid"><span data-i18n="Invalid token">{{t "Invalid token"}}</span></a><p data-recovery-preview role="status"></p></details></div></section>