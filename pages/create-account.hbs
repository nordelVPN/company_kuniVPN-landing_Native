<section class="hero wrap auth-page">{{> auth-art}}<div class="form-card"><p class="eyebrow">kuniVPN</p><h1><span data-i18n="Create account">{{t "Create account"}}</span></h1><form data-form="register" novalidate><div class="field"><label for="register-name"><span data-i18n="Display name">{{t "Display name"}}</span></label><div class="input-wrap"><input id="register-name" name="display_name" type="text" autocomplete="name"></div></div><div class="field"><label for="register-email"><span data-i18n="Email address">{{t "Email address"}}</span></label><div class="input-wrap"><input id="register-email" name="register-email" type="email" required autocomplete="email" aria-describedby="register-email-error"></div><p id="register-email-error" class="field-error" aria-live="polite"></p></div><div class="field"><label for="register-password"><span data-i18n="Password">{{t "Password"}}</span></label><div class="password"><input id="register-password" name="register-password" type="password" required autocomplete="new-password" minlength="8" aria-describedby="register-password-error"><button type="button" class="secondary" data-password="register-password" aria-controls="register-password" aria-pressed="false" data-i18n="Показать">{{t "Показать"}}</button></div><p id="register-password-error" class="field-error" aria-live="polite"></p></div><div class="field"><label for="register-confirm"><span data-i18n="Confirm password">{{t "Confirm password"}}</span></label><div class="password"><input id="register-confirm" name="register-confirm" type="password" required autocomplete="new-password" data-confirm="register-password" aria-describedby="register-confirm-error"><button type="button" class="secondary" data-password="register-confirm" aria-controls="register-confirm" aria-pressed="false" data-i18n="Показать">{{t "Показать"}}</button></div><p id="register-confirm-error" class="field-error" aria-live="polite"></p></div><button class="button wide" type="submit"><span data-i18n="Create account">{{t "Create account"}}</span></button><p class="form-message" data-form-message role="status" aria-live="polite"></p></form><a href="./login.html"><span data-i18n="Back to sign in">{{t "Back to sign in"}}</span></a></div></section>