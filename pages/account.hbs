<section class="section wrap account-page"><h1><span data-i18n="My">{{t "My"}}</span> <em><span data-i18n="Account">{{t "Account"}}</span></em></h1><p class="lead"><span data-i18n="Your profile, subscription and billing. In one place.">{{t "Your profile, subscription and billing. In one place."}}</span></p><p class="prototype-note"><span data-i18n="Prototype account. All previews are local samples; no session or personal data is loaded.">{{t "Prototype account. All previews are local samples; no session or personal data is loaded."}}</span></p><div class="account-layout"><aside class="account-sidebar"><div role="tablist" aria-label="{{t 'Account sections'}}" data-i18n-aria-label="Account sections"><button type="button" class="account-tab" role="tab" id="tab-account" aria-controls="panel-account" aria-selected="true" tabindex="0" data-tab="account">{{> icon person=true}}<span data-i18n="Account">{{t "Account"}}</span></button><button type="button" class="account-tab" role="tab" id="tab-subscription" aria-controls="panel-subscription" aria-selected="false" tabindex="-1" data-tab="subscription">{{> icon layers=true}}<span data-i18n="Subscription">{{t "Subscription"}}</span></button><button type="button" class="account-tab" role="tab" id="tab-billing" aria-controls="panel-billing" aria-selected="false" tabindex="-1" data-tab="billing">{{> icon card=true}}<span data-i18n="Billing">{{t "Billing"}}</span></button><button type="button" class="account-tab" role="tab" id="tab-security" aria-controls="panel-security" aria-selected="false" tabindex="-1" data-tab="security">{{> icon shield=true}}<span data-i18n="Security">{{t "Security"}}</span></button><button type="button" class="account-tab" role="tab" id="tab-preferences" aria-controls="panel-preferences" aria-selected="false" tabindex="-1" data-tab="preferences">{{> icon settings=true}}<span data-i18n="Preferences">{{t "Preferences"}}</span></button></div><article class="card help-card"><h3><span data-i18n="Need help?">{{t "Need help?"}}</span></h3><p><span data-i18n="Find answers in our help collection.">{{t "Find answers in our help collection."}}</span></p><a class="button secondary" href="./index.html#support"><span data-i18n="Contact support">{{t "Contact support"}}</span>{{> icon chevron=true}}</a></article><button type="button" class="secondary wide" data-signout><span data-i18n="Sign Out">{{t "Sign Out"}}</span></button></aside><div class="account-content">
<section role="tabpanel" id="panel-account" aria-labelledby="tab-account" data-panel="account"><h2><span data-i18n="Account details">{{t "Account details"}}</span></h2><div class="account-overview"><div class="overview-primary"><article class="card profile-card"><div class="avatar">{{> icon person=true}}</div><div><h3><span data-i18n="Sample profile">{{t "Sample profile"}}</span></h3><p>demo@example.test</p><p><span data-i18n="Registration date unavailable">{{t "Registration date unavailable"}}</span></p></div><button class="secondary" type="button" data-edit-profile aria-expanded="false" aria-controls="profile-edit"><span data-i18n="Edit profile">{{t "Edit profile"}}</span></button></article><form id="profile-edit" class="card" data-form="profile" hidden novalidate><label for="profile-name"><span data-i18n="Display name">{{t "Display name"}}</span></label><input id="profile-name" name="profile-name" autocomplete="nickname" required aria-describedby="profile-name-error"><p id="profile-name-error" class="field-error"></p><button class="button" type="submit"><span data-i18n="Save changes">{{t "Save changes"}}</span></button><p data-form-message role="status"></p></form><p><span data-i18n="No profile changes are stored without the account API.">{{t "No profile changes are stored without the account API."}}</span></p><article class="card overview-subscription"><span class="status-badge"><span data-i18n="No subscription">{{t "No subscription"}}</span></span><h3>{{> icon layers=true}}<span data-i18n="Subscription">{{t "Subscription"}}</span></h3><p><span data-i18n="No subscription">{{t "No subscription"}}</span></p><p><span data-i18n="Connect the account API to load your plan.">{{t "Connect the account API to load your plan."}}</span></p><dl class="subscription-meta"><div><dt><span data-i18n="Plan">{{t "Plan"}}</span></dt><dd>—</dd></div><div><dt><span data-i18n="Next renewal">{{t "Next renewal"}}</span></dt><dd><span data-i18n="Not available">{{t "Not available"}}</span></dd></div><div><dt><span data-i18n="Price">{{t "Price"}}</span></dt><dd>—</dd></div></dl><div class="overview-actions"><a class="button" href="./index.html#plans"><span data-i18n="View plans">{{t "View plans"}}</span></a><button type="button" class="secondary" data-open-tab="subscription"><span data-i18n="Manage subscription">{{t "Manage subscription"}}</span>{{> icon chevron=true}}</button></div></article></div><div class="overview-secondary"><article class="card payment-overview"><h3>{{> icon card=true}}<span data-i18n="Payment method">{{t "Payment method"}}</span></h3><p><span data-i18n="No saved payment method.">{{t "No saved payment method."}}</span></p><button type="button" class="secondary" data-open-tab="billing"><span data-i18n="Update payment method">{{t "Update payment method"}}</span></button></article><article class="card history-overview"><h3>{{> icon book=true}}<span data-i18n="Billing history">{{t "Billing history"}}</span></h3><p><span data-i18n="No invoices. The billing API is not connected.">{{t "No invoices. The billing API is not connected."}}</span></p><button type="button" class="secondary" data-open-tab="billing"><span data-i18n="View all">{{t "View all"}}</span>{{> icon chevron=true}}</button></article></div></div></section>
<section role="tabpanel" id="panel-subscription" aria-labelledby="tab-subscription" data-panel="subscription" hidden><h2><span data-i18n="Subscription">{{t "Subscription"}}</span></h2><label for="subscription-state"><span data-i18n="Demo state">{{t "Demo state"}}</span></label><select id="subscription-state" data-demo-select="subscription"><option value="empty" data-i18n="No subscription">{{t "No subscription"}}</option><option value="active" data-i18n="Active sample">{{t "Active sample"}}</option><option value="expired" data-i18n="Expired sample">{{t "Expired sample"}}</option></select><article class="card"><div data-demo-group="subscription" data-demo-state="empty"><h3><span data-i18n="No subscription">{{t "No subscription"}}</span></h3><p><span data-i18n="Connect the account API to load your plan.">{{t "Connect the account API to load your plan."}}</span></p></div><div data-demo-group="subscription" data-demo-state="active" hidden><h3><span data-i18n="Active sample">{{t "Active sample"}}</span></h3><p><span data-i18n="Sample only. Renewal date is unavailable.">{{t "Sample only. Renewal date is unavailable."}}</span></p>{{#with subscriptionPlan}}<div class="subscription-preview" data-subscription-plan="{{id}}"><h3 data-i18n="{{name}}">{{t name}}</h3>{{> plan-details}}<dl class="subscription-meta"><div><dt><span data-i18n="Plan">{{t "Plan"}}</span></dt><dd data-i18n="{{name}}">{{t name}}</dd></div><div><dt><span data-i18n="Next renewal">{{t "Next renewal"}}</span></dt><dd><span data-i18n="Not available">{{t "Not available"}}</span></dd></div><div><dt><span data-i18n="Price">{{t "Price"}}</span></dt><dd>€{{price}}</dd></div></dl></div>{{/with}}</div><div data-demo-group="subscription" data-demo-state="expired" hidden><h3><span data-i18n="Expired sample">{{t "Expired sample"}}</span></h3><p><span data-i18n="Demo: renew by selecting an available offer.">{{t "Demo: renew by selecting an available offer."}}</span></p></div><a class="button" href="./index.html#plans"><span data-i18n="Manage subscription">{{t "Manage subscription"}}</span></a></article></section>
<section role="tabpanel" id="panel-billing" aria-labelledby="tab-billing" data-panel="billing" hidden><h2><span data-i18n="Billing">{{t "Billing"}}</span></h2><label for="billing-state"><span data-i18n="Demo state">{{t "Demo state"}}</span></label><select id="billing-state" data-demo-select="billing"><option value="empty" data-i18n="Empty">{{t "Empty"}}</option><option value="loading" data-i18n="Loading">{{t "Loading"}}</option><option value="error" data-i18n="Error">{{t "Error"}}</option><option value="sample" data-i18n="Masked card sample">{{t "Masked card sample"}}</option></select><div class="billing-grid"><article class="card"><h3><span data-i18n="Payment method">{{t "Payment method"}}</span></h3><div data-demo-group="billing" data-demo-state="empty"><p><span data-i18n="No saved payment method.">{{t "No saved payment method."}}</span></p></div><div data-demo-group="billing" data-demo-state="loading" hidden><p><span data-i18n="Loading sample…">{{t "Loading sample…"}}</span></p></div><div data-demo-group="billing" data-demo-state="error" hidden><p><span data-i18n="Demo error: provider unavailable.">{{t "Demo error: provider unavailable."}}</span></p><button class="secondary" data-demo-retry="billing"><span data-i18n="Retry">{{t "Retry"}}</span></button></div><div data-demo-group="billing" data-demo-state="sample" hidden><p><span data-i18n="Sample only: card •••• 0000">{{t "Sample only: card •••• 0000"}}</span></p><p><span data-i18n="Expiry unavailable">{{t "Expiry unavailable"}}</span></p></div><button class="secondary" type="button" data-account-action><span data-i18n="Update payment method">{{t "Update payment method"}}</span></button></article><article class="card"><h3><span data-i18n="Billing history">{{t "Billing history"}}</span></h3>{{> billing-history}}<button class="secondary" type="button" data-account-action><span data-i18n="View all">{{t "View all"}}</span></button></article></div><p data-account-message role="status"></p></section>
<section role="tabpanel" id="panel-security" aria-labelledby="tab-security" data-panel="security" hidden><h2><span data-i18n="Security">{{t "Security"}}</span></h2><article class="card"><h3><span data-i18n="Password and sessions">{{t "Password and sessions"}}</span></h3><a class="button" href="./forgot-password.html"><span data-i18n="Change password">{{t "Change password"}}</span></a><p><span data-i18n="No sessions are loaded. Session access requires server authentication.">{{t "No sessions are loaded. Session access requires server authentication."}}</span></p><button class="secondary" data-preview-session><span data-i18n="Preview expired session">{{t "Preview expired session"}}</span></button><p data-session-message role="status"></p></article></section>
<section role="tabpanel" id="panel-preferences" aria-labelledby="tab-preferences" data-panel="preferences" hidden><h2><span data-i18n="Preferences">{{t "Preferences"}}</span></h2><article class="card"><label for="account-language" data-i18n="Язык">{{t "Язык"}}</label><select id="account-language" data-language-select><option value="en">EN</option><option value="ru">RU</option></select><p><span data-i18n="Language is stored on this device. Server preferences are unavailable.">{{t "Language is stored on this device. Server preferences are unavailable."}}</span></p></article></section>
<section class="card" id="vpn-access" data-sdk-vpn-panel style="margin-top:1.5rem;"><h2>VPN Key &amp; Available Servers</h2><p data-sdk-status hidden role="status"></p><div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center;margin:0.75rem 0;"><code data-sdk-vpn-key>••••••••••••</code><button type="button" class="secondary" data-sdk-key-reveal>Show</button><button type="button" class="secondary" data-sdk-key-copy>Copy</button></div><div style="overflow-x:auto;margin-bottom:1rem;"><table style="width:100%;border-collapse:collapse;"><thead><tr><th align="left">Location</th><th align="left">Status</th><th align="left">Ping</th><th align="left">Protocols</th></tr></thead><tbody data-sdk-servers><tr><td colspan="4">Loading servers...</td></tr></tbody></table></div><h3>Connected Devices (<span data-sdk-devices-count>0 / 5</span>)</h3><div style="overflow-x:auto;"><table style="width:100%;border-collapse:collapse;"><thead><tr><th align="left">Device</th><th align="left">Platform</th><th align="left">Last Active</th><th align="left">Action</th></tr></thead><tbody data-sdk-devices><tr><td colspan="4">Loading devices...</td></tr></tbody></table></div><h3 style="margin-top:1.5rem;">Billing History</h3><div style="overflow-x:auto;margin-bottom:1rem;"><table style="width:100%;border-collapse:collapse;"><thead><tr><th align="left">Date</th><th align="left">Plan</th><th align="left">Amount</th><th align="left">Status</th></tr></thead><tbody data-sdk-billing><tr><td colspan="4">Loading payments...</td></tr></tbody></table></div><h3>Security &amp; Support</h3><div style="margin:0.75rem 0;"><button type="button" class="secondary" data-logout-all>Revoke all sessions</button></div><form data-password-form style="display:grid;gap:0.5rem;margin-bottom:1rem;"><input type="password" name="current_password" placeholder="Current password" required><input type="password" name="password" placeholder="New password (min 8 chars)" required minlength="8"><input type="password" name="password_confirmation" placeholder="Confirm new password" required minlength="8"><button type="submit" class="secondary">Update password</button></form><form data-support-form style="display:grid;gap:0.5rem;"><input type="text" name="subject" placeholder="Support subject" required minlength="3"><textarea name="message" rows="3" placeholder="How can we help?" required minlength="5"></textarea><button type="submit" class="button">Send support request</button></form></section>
</div></div></section>
